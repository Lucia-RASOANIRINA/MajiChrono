<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawable volontairement vide, pour l'ecran de demarrage d'Android 12+.

  `@android:color/transparent` ne suffit pas a cet emplacement : le systeme
  attend un drawable, et devant une simple couleur il retombe sur l'icone du
  lanceur — le logo reapparaissait donc malgre la consigne. Une forme
  explicitement transparente, elle, est acceptee telle quelle.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <size android:width="1dp" android:height="1dp" />
</shape>
