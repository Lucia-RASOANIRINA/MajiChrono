<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 et au-dela imposent leur propre ecran de demarrage. On y pose
      le logo MajiChrono (le meme scooter que l'icone de lanceur) sur le bleu de
      la charte. Le cercle d'icone est peint du meme bleu que le fond, donc le
      logo semble flotter sur l'aplat, sans pastille contrastee : l'ecran se
      remplit d'un bloc au lieu de montrer un bleu nu pendant l'init du moteur.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_blue</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
