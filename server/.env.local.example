# PostgreSQL LOCAL — pour developper et tester sans reseau.
#
# Aucune latence, aucun quota, et la base se jette et se recree en une commande.
# C'est le profil a utiliser pour les tests et le developpement quotidien.
#
# Demarrer PostgreSQL par conteneur :
#   docker run -d --name majichrono-db -p 5432:5432 \
#     -e POSTGRES_USER=majichrono -e POSTGRES_PASSWORD=majichrono \
#     -e POSTGRES_DB=majichrono postgres:16
#
# Puis :  copy .env.local.example .env

ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://majichrono:majichrono@localhost:5432/majichrono
JWT_SECRET=dev-local-uniquement-ne-jamais-utiliser-en-production-3f9a2c

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=rasoanirinambolatiana8@gmail.com
MAIL_FROM_NAME=MajiChrono

SMS_API_KEY=
SMS_SENDER=MajiChrono
